{
  "name": "typeorm-translations",
  "version": "0.1.0",
  "description": "Database-backed translations for NestJS + TypeORM: a translations table, locale from ?lang / Accept-Language, automatic substitution in responses",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "typeorm",
    "translations",
    "i18n",
    "localization",
    "translatable",
    "postgres"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestkit-studio/typeorm-translations.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "jest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/testing": "^10.4.20",
    "@nestjs/typeorm": "^10.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/supertest": "^6.0.2",
    "jest": "^30.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3"
  },
  "author": "Viktoriia Shakhova <viktori237t@gmail.com>"
}
